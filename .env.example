# ========================================================
# PENGATURAN DATABASE POSTGRESQL LOKAL / DOCKER
# ========================================================
# Jika menggunakan database lokal sendiri atau Docker, gunakan variabel berikut:
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="cat_user"
DB_PASSWORD="cat_password_123"
DB_NAME="cat_db"

# Port Server Aplikasi
PORT=3000

# ========================================================
# PENGATURAN CLOUD SQL (AI Studio)
# ========================================================
# Pada lingkungan Cloud SQL AI Studio, variabel SQL_* akan otomatis diinjeksikan:
# SQL_HOST="/cloudsql/project:region:instance"
# SQL_USER="ai_studio_app"
# SQL_PASSWORD="..."
# SQL_DB_NAME="ai_studio_db"

# GEMINI_API_KEY: Opsional untuk fitur AI tambahan jika diperlukan
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
